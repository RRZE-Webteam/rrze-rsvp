{
    "name": "rrze/rrze-rsvp",
    "version": "2.11.8",
    "require": {
        "cmb2/cmb2": "^2.11.0",
        "tecnickcom/tcpdf": "^6.8.2"
    },
    "autoload": {
        "psr-4": {
            "RRZE\\RSVP\\": "includes/"
        },
        "files": [
            "vendor/cmb2/cmb2/init.php"
        ],
        "classmap": [
            "vendor/tecnickcom/tcpdf/tcpdf.php",
            "vendor/tecnickcom/tcpdf/tcpdf_barcodes_2d.php"
        ]
    },
    "scripts": {
        "test": [
            "php tests/booking-lifecycle.php",
            "php tests/booking-picker.php",
            "php tests/timeslot-compatibility.php",
            "php tests/course-core.php",
            "php tests/course-notifications.php",
            "php tests/course-admin.php",
            "php tests/course-frontend.php",
            "php tests/course-module.php"
        ]
    },
    "extra": {
        "installer-paths": {
            "vendor/cmb2/cmb2": [
                "cmb2/cmb2"
            ]
        }
    }
}
