{
    "name": "rrze-rsvp",
    "version": "2.12.0",
    "main": "rrze-rsvp.php",
    "scripts": {
        "start": "webpack --mode=development --watch",
        "build": "webpack --mode=production && npm run build:block && npm run build:email",
        "build:block": "npm run typecheck && wp-scripts build --config webpack.blocks.config.js --webpack-src-dir=src/blocks --webpack-copy-php && npm run build:block-translations",
        "dev:block": "wp-scripts start --config webpack.blocks.config.js --webpack-src-dir=src/blocks --webpack-copy-php",
        "typecheck": "tsc --noEmit",
        "test": "node --test tests/*.test.cjs && node tools/build-block-translations.mjs --check",
        "clean": "rm -rf build/",
        "build:email": "maizzle build --config mail/maizzle.config.ts && node mail/verify-template.mjs",
        "dev:email": "maizzle serve --config mail/maizzle.config.ts",
        "build:block-translations": "node tools/build-block-translations.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RRZE-Webteam/rrze-rsvp.git",
        "issues": "https://github.com/RRZE-Webteam/rrze-rsvp/issues",
        "clone": "git+https://github.com/RRZE-Webteam/rrze-rsvp.git"
    },
    "browserslist": [
        "last 3 years",
        "ie 11"
    ],
    "supports": {
        "email": "webmaster@fau.de",
        "docs": "https://www.wordpress.rrze.fau.de/plugins/fau-und-rrze-plugins/rsvp/"
    },
    "author": "RRZE-Webteam <webmaster@fau.de> (https://www.wordpress.rrze.fau.de/person/webmaster)",
    "license": "GPL-3.0-or-later",
    "bugs": {
        "url": "https://github.com/RRZE-Webteam/rrze-rsvp/issues"
    },
    "homepage": "https://github.com/RRZE-Webteam/rrze-rsvp#readme",
    "devDependencies": {
        "@babel/core": "^7.29",
        "@babel/preset-env": "^7.29",
        "@maizzle/framework": "6.0.13",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "@types/wordpress__api-fetch": "3.2.4",
        "@types/wordpress__block-editor": "15.0.9",
        "@types/wordpress__blocks": "15.17.0",
        "@wordpress/api-fetch": "8.0.0",
        "@wordpress/block-editor": "19.0.0",
        "@wordpress/blocks": "15.24.0",
        "@wordpress/components": "38.0.0",
        "@wordpress/data": "10.52.0",
        "@wordpress/element": "8.4.0",
        "@wordpress/i18n": "6.25.0",
        "@wordpress/primitives": "4.52.0",
        "@wordpress/scripts": "30.27.0",
        "autoprefixer": "^10.4.27",
        "babel-loader": "^10.1.1",
        "clean-webpack-plugin": "^4.0.0",
        "css-loader": "^7.1.4",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "gettext-parser": "1.4.0",
        "mini-css-extract-plugin": "^2.10.2",
        "postcss-loader": "^8.2.1",
        "sass": "^1.99.0",
        "sass-loader": "^16.0.7",
        "semver": "^7.7.4",
        "style-loader": "^4.0.0",
        "terser-webpack-plugin": "^5.4.0",
        "typescript": "5.9.3",
        "webpack": "^5.105.4",
        "webpack-cli": "^7.0.2"
    }
}
